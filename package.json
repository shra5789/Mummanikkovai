{
  "name": "slokam-player",
  "productName": "Slokam Player",
  "version": "1.0.0",
  "description": "A small transparent always-on-top widget that plays slokam recitations with synced lyrics. Starts with Swami Desikan's Mummanikkovai.",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis --publish never",
    "dist:dir": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.slokamplayer.app",
    "productName": "Slokam Player",
    "files": ["main.js", "preload.js", "src/**/*", "assets/**/*"],
    "win": {
      "icon": "assets/icon.ico",
      "target": ["portable", "nsis"]
    },
    "portable": { "artifactName": "SlokamPlayer-portable.exe" },
    "nsis": { "artifactName": "SlokamPlayer-setup.exe", "oneClick": true }
  }
}
